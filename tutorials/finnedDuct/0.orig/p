FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Kinematic pressure, p/rho, in m^2/s^2

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            zeroGradient;
    }

    // This fixedValue patch sets the pressure level of the whole domain, so
    // pRefCell / pRefValue in the COUPLED dictionary are not used.  It also
    // makes the inlet-average pressure directly the inlet-to-outlet drop.
    outlet
    {
        type            fixedValue;
        value           uniform 0;
    }

    bottomPlate
    {
        type            zeroGradient;
    }

    topPlate
    {
        type            zeroGradient;
    }

    sideWall_lo
    {
        type            symmetry;
    }

    sideWall_hi
    {
        type            symmetry;
    }

    fins
    {
        type            zeroGradient;
    }
}

