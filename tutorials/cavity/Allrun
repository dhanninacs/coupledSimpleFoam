#!/bin/sh
#------------------------------------------------------------------------------
# coupledSimpleFoam tutorial `cavity` - mesh, solve and report.
#
# This file is part of coupledSimpleFoam and is distributed under the GNU
# General Public License version 3; see the LICENSE file at the root of this
# repository.
#
# Usage
#     ./Allrun
#
# Runs in serial and takes a couple of seconds.  Exits non-zero if any step
# fails, so the script is usable as a smoke test.
#------------------------------------------------------------------------------
cd "${0%/*}" || exit 1

if [ -z "$WM_PROJECT_DIR" ]
then
    echo "Allrun: the OpenFOAM environment is not set." 1>&2
    echo "        Source the installation's etc/bashrc first, for example" 1>&2
    echo "            . /opt/openfoam14/etc/bashrc" 1>&2
    exit 1
fi

if ! command -v coupledSimpleFoam > /dev/null 2>&1
then
    echo "Allrun: coupledSimpleFoam is not on PATH." 1>&2
    echo "        Build it with the repository's ./Allwmake first." 1>&2
    exit 1
fi

# OpenFOAM's runApplication skips a step whose log file already exists and
# swallows the application's exit status.  A tutorial that doubles as a
# regression test needs neither behaviour, so use this wrapper instead: it
# always runs, and it stops the script on the first failure.
runApp()
{
    _app=$1
    shift
    echo "Running $_app on $PWD"
    if ! "$_app" "$@" > "log.$_app" 2>&1
    then
        echo "Allrun: $_app FAILED; last 20 lines of log.$_app:" 1>&2
        tail -20 "log.$_app" 1>&2
        exit 1
    fi
}

#------------------------------------------------------------------------------
# Mesh
#------------------------------------------------------------------------------
runApp blockMesh

# Fields live in 0.orig and are copied into place after meshing.  Nothing in
# this case needs that ordering, but every tutorial here follows it so that a
# case can be re-run any number of times without a fresh checkout.
rm -rf 0
cp -r 0.orig 0

#------------------------------------------------------------------------------
# Solve
#------------------------------------------------------------------------------
runApp coupledSimpleFoam

#------------------------------------------------------------------------------
# Report
#------------------------------------------------------------------------------
log=log.coupledSimpleFoam

if ! grep -q "COUPLED solution converged" "$log"
then
    echo "Allrun: the solver did not converge; see $log" 1>&2
    exit 1
fi

iters=$(sed -n 's/.*COUPLED solution converged in \([0-9][0-9]*\) iterations.*/\1/p' "$log")
divPhi=$(sed -n 's/.*coupled assembly check: sum|div(phi)| = \([^ ]*\).*/\1/p' "$log" | tail -1)

echo
echo "===================================================================="
echo "cavity - lid-driven cavity, Re = 100, 64x64, laminar"
echo "--------------------------------------------------------------------"
grep -m1 "Pressure level:"        "$log" | sed 's/^/  /'
grep -m1 "Coupled p-U system:"    "$log" | sed 's/^/  /'
echo "  Outer iterations to convergence : $iters   (expected 12)"
echo "  Final sum|div(phi)|             : $divPhi   (expected ~1e-16)"
echo "  Segregated SIMPLE reference     : 755 iterations"
echo "===================================================================="

[ "$iters" = "12" ] || echo "NOTE: iteration count differs from the reference value of 12."

#------------------------------------------------------------------------------
