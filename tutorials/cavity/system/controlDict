FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     coupledSimpleFoam;

// Read only by `foamRun`, which is how the segregated SIMPLE reference run
// is produced from this same case directory.  coupledSimpleFoam ignores it.
solver          incompressibleFluid;

startFrom       startTime;

startTime       0;

stopAt          endTime;

// Iteration cap.  Both solvers stop on residualControl long before this.
endTime         5000;

deltaT          1;

writeControl    timeStep;

writeInterval   5000;

purgeWrite      2;

writeFormat     ascii;

writePrecision  12;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable false;

// ************************************************************************* //
