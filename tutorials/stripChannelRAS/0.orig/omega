FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// omega = k^0.5/(Cmu^0.25*L) with L = 0.1*H

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 45;

boundaryField
{
    inlet        { type fixedValue;        value uniform 45; }
    outlet       { type zeroGradient; }
    walls        { type omegaWallFunction; value uniform 45; }
    fins         { type omegaWallFunction; value uniform 45; }
    frontAndBack { type empty; }
}

