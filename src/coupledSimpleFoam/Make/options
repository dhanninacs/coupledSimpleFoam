# file at the root of this repository.  Full build instructions are in
# doc/INSTALL.md.
#
# Linear-algebra backends
#   Eigen  (serial, always built)   header only.  The include flag comes from
#                                   EIGEN_INC and defaults to the Debian /
#                                   Ubuntu location -I/usr/include/eigen3.
#   PETSc  (parallel, optional)     enabled automatically whenever a PETSc
#                                   pkg-config file is found.
#
# Environment switches - nothing below is baked into the repository:
#
#   COUPLED_NO_PETSC=1  Build the serial Eigen-only solver even when PETSc is
#                       installed.
#   EIGEN_INC           Include flag for the Eigen headers, for example
#                       EIGEN_INC=-I/opt/eigen/include.
#
# -DHAVE_PETSC is the only thing that enables the PETSc backend:
# petscCoupledSolver.C compiles to an empty object file without it, and the
# backend factory then reports a helpful runtime error.
#
# The solver sources are device agnostic.  An optional CUDA build layer for
# NVIDIA GPUs lives in a companion repository and reuses these same sources
# unchanged; see the README.
#------------------------------------------------------------------------------

EIGEN_INC ?= -I/usr/include/eigen3

PETSC_CFLAGS := $(shell pkg-config --cflags PETSc 2>/dev/null || pkg-config --cflags petsc 2>/dev/null)
PETSC_LDFLAGS := $(shell pkg-config --libs PETSc 2>/dev/null || pkg-config --libs petsc 2>/dev/null)

ifeq ($(COUPLED_NO_PETSC),1)
    PETSC_CFLAGS :=
    PETSC_LDFLAGS :=
endif

PETSC_INC :=
PETSC_LIB :=

# PETSc's .pc file does not carry the MPI include path, so pull it from the
# system MPI wrapper.  --showme is understood by OpenMPI, which is what
# WM_MPLIB=SYSTEMOPENMPI builds against; on an MPICH stack these come back
# empty and the MPI include path has to be added by hand through EXE_INC or by
# an mpicc wrapper on PATH that accepts --showme.
MPI_CFLAGS := $(shell mpicc --showme:compile 2>/dev/null)
MPI_LDFLAGS := $(shell mpicc --showme:link 2>/dev/null)

# -DOMPI_SKIP_MPICXX keeps the deprecated OpenMPI C++ bindings out of the
# OpenFOAM translation units.
ifneq ($(strip $(PETSC_CFLAGS)),)
    PETSC_INC := -DHAVE_PETSC -DOMPI_SKIP_MPICXX $(PETSC_CFLAGS) $(MPI_CFLAGS)
    PETSC_LIB := $(PETSC_LDFLAGS) $(MPI_LDFLAGS)
endif

# Momentum-transport / viscosity framework: the same include and library set
# the stock incompressibleFluid solver module uses.
#   libmomentumTransportModels               base classes + wall functions
#   libincompressibleMomentumTransportModels  laminar/RAS/LES incompressible
#   libphysicalProperties                    viscosityModel (physicalProperties)
#   libmeshTools                             syncTools, wedge/symmetry patches
# NVIDIA AmgX (serial GPU backend, linearSolver AmgX): active only when AMGX_DIR names an AmgX
# install prefix (include/amgx_c.h, lib/libamgxsh.so). Without it the backend compiles to nothing.
AMGX_INC :=
AMGX_LIB :=
# The run-time path to libamgxsh.so; set AMGX_RPATH= (empty) for a Windows (MinGW) build,
# where amgxsh.dll is found beside the executable.
AMGX_RPATH ?= -Wl,-rpath,$(AMGX_DIR)/lib
ifneq ($(strip $(AMGX_DIR)),)
    AMGX_INC := -DHAVE_AMGX -I$(AMGX_DIR)/include
    AMGX_LIB := -L$(AMGX_DIR)/lib -lamgxsh $(AMGX_RPATH)
endif

EXE_INC = \
    -fopenmp \
    $(EIGEN_INC) \
    -I$(LIB_SRC)/MomentumTransportModels/momentumTransportModels/lnInclude \
    -I$(LIB_SRC)/MomentumTransportModels/incompressible/lnInclude \
    -I$(LIB_SRC)/physicalProperties/lnInclude \
    -I$(LIB_SRC)/finiteVolume/lnInclude \
    -I$(LIB_SRC)/meshTools/lnInclude \
    $(PETSC_INC) \
    $(AMGX_INC)

EXE_LIBS = \
    -fopenmp \
    -lmomentumTransportModels \
    -lincompressibleMomentumTransportModels \
    -lphysicalProperties \
    -lfiniteVolume \
    -lmeshTools \
    $(PETSC_LIB) \
    $(AMGX_LIB)
